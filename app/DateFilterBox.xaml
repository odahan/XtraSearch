<UserControl x:Class="XtraSearch.DateFilterBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="yyyy-MM-dd"
                 AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <ToggleButton x:Name="CalendarButton" Grid.Column="1" Width="34" Margin="4,0,0,0" VerticalAlignment="Stretch"
                      Background="#263245" Foreground="#EAF2FE" BorderBrush="#3C4A5E"
                      ToolTip="Open calendar" AutomationProperties.Name="Open calendar">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#34465E"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#65C9FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <Path Stroke="#EAF2FE" StrokeThickness="1.3"
                  Data="M1,3 H15 V15 H1 Z M1,7 H15 M5,1 V5 M11,1 V5 M4,10 H6 M8,10 H10 M4,12 H6"/>
        </ToggleButton>
        <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=CalendarButton}" Placement="Bottom"
               StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=CalendarButton, Mode=TwoWay}"
               Opened="CalendarOpened">
            <Border Background="#171D27" BorderBrush="#43516A" BorderThickness="1" Padding="4"
                    PreviewKeyDown="CalendarKeyDown">
                <Calendar x:Name="Picker" Language="en-US"
                          SelectedDatesChanged="CalendarDateChanged" PreviewMouseUp="CalendarMouseUp"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>

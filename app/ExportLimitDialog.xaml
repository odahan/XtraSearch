<Window x:Class="XtraSearch.ExportLimitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export results" Background="{StaticResource Surface}" Foreground="#E2E8F0"
        Width="400" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FocusManager.FocusedElement="{Binding ElementName=LimitInput}">
    <StackPanel Margin="22">
        <TextBlock x:Name="TotalText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <Label Content="_Results to export" Target="{Binding ElementName=LimitInput}"
               Foreground="#E2E8F0" Padding="0,0,0,5"/>
        <TextBox x:Name="LimitInput"/>
        <TextBlock x:Name="LimitHint" Foreground="#A8B7CB" Margin="0,6,0,18" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="ContinueButton" Content="Continue" IsDefault="True" Click="OnContinue"/>
        </StackPanel>
    </StackPanel>
</Window>

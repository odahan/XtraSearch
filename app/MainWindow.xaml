<Window x:Class="XtraSearch.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:XtraSearch" Title="XtraSearch" Icon="Assets/XtraSearch.ico" Width="1320" Height="860" MinWidth="1050" MinHeight="700" Background="#0C1119" Foreground="#E2E8F0" WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding StartCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding StartCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding StopCommand}"/>
    </Window.InputBindings>
    <Grid Margin="22,16,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="66"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Top">
                <Border Width="42" Height="42" Background="#123A53" CornerRadius="10" Margin="0,0,13,0">
                    <TextBlock Text="⌕" Foreground="#6AD1FF" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="XtraSearch" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Find files. Search deeper." Foreground="#899BB3" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5,0,0">
                <Button Content="New search" Command="{Binding NewSearchCommand}" Margin="0,0,8,0"/>
                <Button Content="Open…" Command="{Binding LoadSearchCommand}" Margin="0,0,8,0"/>
                <Button Content="Save search" Command="{Binding SaveSearchCommand}" Margin="0,0,8,0"/>
                <Button Content="Help" Command="{Binding HelpCommand}" ToolTip="Open the search guide" Padding="13,8"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="#171D27" BorderBrush="#303A49" BorderThickness="1" CornerRadius="8" Padding="18,6,18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="146"/>
                </Grid.ColumnDefinitions>
                <TabControl Grid.Column="0" Margin="0,0,20,0" BorderThickness="0" Background="Transparent">
                    <TabItem Header="Main">
                        <Grid Margin="0,13,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="98"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="File name" VerticalAlignment="Center"/>
                            <DockPanel Grid.Column="1" Grid.ColumnSpan="2">
                                <Button DockPanel.Dock="Right" Content="Test…" Command="{Binding EditRegexCommand}" CommandParameter="FileName"
                                        Margin="8,4,0,4" Padding="11,5" AutomationProperties.Name="Test file name regular expression">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NameMode}" Value="Regex">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <ComboBox IsEditable="True" IsTextSearchEnabled="False"
                 Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding FileNameHistory}"
                 Margin="0,4,0,4" ToolTip="For example: *.txt;*.log" AutomationProperties.Name="File name"/>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="Containing text" VerticalAlignment="Center"/>
                            <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                                <Button DockPanel.Dock="Right" Content="Test…" Command="{Binding EditRegexCommand}" CommandParameter="Content"
                                        Margin="8,4,0,4" Padding="11,5" AutomationProperties.Name="Test contents regular expression">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ContentMode}" Value="Regex">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <ComboBox IsEditable="True" IsTextSearchEnabled="False"
                 Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding ContentHistory}"
                 Margin="0,4,0,4" ToolTip="Leave empty to search by file name only" AutomationProperties.Name="Containing text"/>
                            </DockPanel>
                            <TextBlock Grid.Row="2" Text="Look in" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="False"
                 Text="{Binding Locations, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding LocationHistory}"
                 Margin="0,4,8,4" ToolTip="Files or folders separated by ;. Prefix exclusions with !" AutomationProperties.Name="Look in"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Command="{Binding BrowseCommand}" Margin="0,4,0,4" Padding="8,5"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <CheckBox Content="Include subfolders" IsChecked="{Binding Subfolders}"/>
                                <CheckBox Content="Whole words" IsChecked="{Binding WholeWord}"/>
                                <TextBlock Text="Separate name patterns and locations with a semicolon" FontSize="11" Foreground="#8093AC" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Size &amp; Dates">
                        <Grid Margin="8,14,0,0" Height="163">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="44"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Size" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="&gt;" VerticalAlignment="Center"/>
                            <Grid Grid.Column="2" Grid.ColumnSpan="3" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding MinimumSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"
                                         ToolTip="Minimum, exclusive" AutomationProperties.Name="Minimum file size"/>
                                <TextBlock Grid.Column="1" Text="&lt;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="2" Text="{Binding MaximumSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"
                                         ToolTip="Maximum, exclusive" AutomationProperties.Name="Maximum file size"/>
                                <ComboBox Grid.Column="4" ItemsSource="{Binding SizeUnits}" SelectedItem="{Binding SizeUnit}"
                                          Margin="0,4" ToolTip="Unit for both size limits" AutomationProperties.Name="File size unit"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Modified" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="From" FontSize="11" VerticalAlignment="Center"/>
                            <local:DateFilterBox Grid.Row="1" Grid.Column="2" Text="{Binding ModifiedAfter}" Margin="0,4" AutomationProperties.Name="Modified from"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Through" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <local:DateFilterBox Grid.Row="1" Grid.Column="4" Text="{Binding ModifiedBefore}" Margin="0,4" AutomationProperties.Name="Modified through"/>
                            <TextBlock Grid.Row="2" Text="Created" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="From" FontSize="11" VerticalAlignment="Center"/>
                            <local:DateFilterBox Grid.Row="2" Grid.Column="2" Text="{Binding CreatedAfter}" Margin="0,4" AutomationProperties.Name="Created from"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="Through" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <local:DateFilterBox Grid.Row="2" Grid.Column="4" Text="{Binding CreatedBefore}" Margin="0,4" AutomationProperties.Name="Created through"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Options">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="File Name" Padding="8,12,8,3" Margin="0,0,8,0">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding NameModes}" SelectedValuePath="Value" DisplayMemberPath="Label"
                   SelectedValue="{Binding NameMode}" AutomationProperties.Name="File name match mode"/>
                                    <CheckBox Content="Match case" IsChecked="{Binding NameCase}"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Grid.Column="1" Grid.Row="0" Header="Contents" Padding="8,12,8,3" Margin="0,0,8,0">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding ContentModes}" SelectedValuePath="Value" DisplayMemberPath="Label"
                   SelectedValue="{Binding ContentMode}" AutomationProperties.Name="Contents match mode"/>
                                    <CheckBox Content="Match case" IsChecked="{Binding ContentCase}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Parallel search workers"  Grid.Column="2" Grid.Row="0" Padding="8,12,8,3" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBox Text="{Binding WorkerCount, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left"
                                             AutomationProperties.Name="Parallel search workers"/>
                                    <TextBlock Text="{Binding WorkerHint}" Foreground="#91A6BF" Margin="0,6,0,3"/>
                                    <TextBlock Text="0 = automatic. Use 1 for a slow mechanical drive." Foreground="#8194AD" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Other options"  Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Padding="8,12,8,3" Margin="0,0,8,0">
                                <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                                    <CheckBox Content="Match Boolean expressions line by line" IsChecked="{Binding LineByLine}"/>
                                    <CheckBox Content="Include hidden and system files" IsChecked="{Binding IncludeHidden}"/>
                                    <CheckBox Content="Skip binary file contents" IsChecked="{Binding SkipBinary}"/>
                                    <CheckBox Content="Search inside ZIP archives" IsChecked="{Binding SearchArchives}"/>
                                </WrapPanel>
                            </GroupBox>

                        </Grid>
                    </TabItem>
                </TabControl>
                <StackPanel Grid.Column="1" Margin="0,41,0,0">
                    <Button Content="▶  Start search" Command="{Binding StartCommand}" ToolTip="Start search (Ctrl+Enter)" Background="#1684C1" BorderBrush="#35A4DA" FontWeight="SemiBold" Padding="8,11"/>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}" Padding="4,8"/>
                        <Button Grid.Column="2" Content="Stop" Command="{Binding StopCommand}" Padding="4,8"/>
                    </Grid>
                    <TextBlock Foreground="#8598B1" FontSize="10" HorizontalAlignment="Center" Margin="0,12,0,0">Ctrl+Enter or F5 to search<LineBreak/>Esc to stop</TextBlock>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="350" MinWidth="280"/>
            </Grid.ColumnDefinitions>
            <Border Background="#111720" BorderBrush="#303A49" BorderThickness="1" CornerRadius="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*" MinHeight="64"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="SearchThreadsRow" Height="0"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="14,8">
                        <Button DockPanel.Dock="Right" Content="Export…" Command="{Binding ExportCommand}" Padding="11,5"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Search results" FontWeight="SemiBold" FontSize="15"/>
                            <Border Background="#20364C" CornerRadius="9" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding FoundText}" Foreground="#78CFFE" FontSize="12"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" MouseDoubleClick="ResultsDoubleClick" PreviewMouseRightButtonUp="ResultsRightClick" KeyDown="ResultsKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="210"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Bytes" Width="92"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="145"/>
                            <DataGridTextColumn Header="Hits" Binding="{Binding Hits}" Width="62"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="24">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResults}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="⌕" FontSize="64" Foreground="#344D68" HorizontalAlignment="Center"/>
                        <TextBlock Text="Your next find starts here" FontSize="18" Foreground="#C2D0E2" HorizontalAlignment="Center" Margin="0,10,0,9"/>
                        <TextBlock Text="Choose a folder and enter a file name or text.&#10;Leave the text empty to find files by name." TextAlignment="Center" Foreground="#8093AD" LineHeight="22"/>
                    </StackPanel>
                    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                   ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#303A49"
                   Visibility="{Binding ShowSearchThreads, Converter={StaticResource BooleanToVisibility}}"/>
                    <Grid Grid.Row="3" Visibility="{Binding ShowSearchThreads, Converter={StaticResource BooleanToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Search Threads" FontWeight="SemiBold" Margin="14,6"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding WorkerRows}" RowHeight="28"
                AutomationProperties.Name="Search Threads">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="12,3"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Thread" Binding="{Binding Worker}" Width="68"/>
                                <DataGridTextColumn Header="Seconds" Binding="{Binding Seconds, StringFormat=N2}" Width="84"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="145"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" MinWidth="95"/>
                                <DataGridTextColumn Header="Lines" Binding="{Binding Lines, StringFormat=N0}" Width="72"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="82"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="204"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#171D27" BorderBrush="#303A49" BorderThickness="1" CornerRadius="7" Padding="17,14">
                    <StackPanel>
                        <TextBlock Text="Search summary" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding FoundText}" FontSize="27" Foreground="#6ACBFC"/>
                                <TextBlock Text="FILES FOUND" FontSize="10" Foreground="#8CA0BA" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding ElapsedText}" FontSize="27"/>
                                <TextBlock Text="ELAPSED TIME" FontSize="10" Foreground="#8CA0BA" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border BorderBrush="#303A49" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Files checked" Foreground="#8CA0BA" FontSize="11"/>
                                    <TextBlock Text="{Binding CheckedText}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Skipped / unreadable" Foreground="#8CA0BA" FontSize="11"/>
                                    <TextBlock Text="{Binding SkippedText}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Background="#171D27" BorderBrush="#303A49" BorderThickness="1" CornerRadius="7">
                    <TabControl BorderThickness="0" Margin="1">
                        <TabItem Header="Preview">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding PreviewTitle}" Margin="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBox Grid.Row="1" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0" Background="#111720"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8">
                                    <Button Content="Open" Command="{Binding OpenFileCommand}" Padding="10,6" Margin="0,0,6,0"/>
                                    <Button Content="Folder" Command="{Binding OpenFolderCommand}" Padding="10,6" Margin="0,0,6,0"/>
                                    <Button Content="Copy path" Command="{Binding CopyPathCommand}" Padding="10,6"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Search log">
                            <TextBox Text="{Binding ErrorText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#111720" FontSize="12"/>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
        <DockPanel Grid.Row="4" VerticalAlignment="Center">
            <TextBlock DockPanel.Dock="Right" Text="{Binding ScannedText}" Foreground="#748AA5" FontSize="11" VerticalAlignment="Center"/>
            <ToggleButton DockPanel.Dock="Right" Content="{Binding SearchThreadsText}" IsChecked="{Binding ShowSearchThreads}"
                 Visibility="{Binding HasParallelContentSearch, Converter={StaticResource BooleanToVisibility}}"
                 Checked="SearchThreadsToggled" Unchecked="SearchThreadsToggled"
                 Foreground="#78CFFE" Background="#171D27" BorderBrush="#394558" Padding="8,3" Margin="0,0,12,0"
                 ToolTip="Show or hide search thread progress"/>
            <TextBlock Text="●" Foreground="#57C9AE" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Status}" Foreground="#9BAFC7" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>

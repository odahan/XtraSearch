<Window x:Class="XtraSearch.RegexEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Regex Editor" Background="#0C1119" Foreground="#E2E8F0"
        Width="900" Height="680" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Snippet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="7,5"/>
            <EventSetter Event="Click" Handler="OnInsertSnippet"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="252"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
            <TextBlock Text="Regex Editor" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Heading}" Foreground="#A8B7CB"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox Content="Match case" IsChecked="{Binding MatchCase}" Margin="0"/>
                        <CheckBox Content="Whole words" IsChecked="{Binding WholeWords}" Margin="12,0,0,0">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFileName}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </StackPanel>
                    <TextBlock Text="Pattern" Style="{StaticResource SectionTitle}"/>
                </DockPanel>
                <TextBox x:Name="PatternInput" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Regular expression" FontFamily="Cascadia Mono, Consolas"/>
                <DockPanel Margin="0,6,0,12">
                    <Button x:Name="ErrorPosition" DockPanel.Dock="Right" Visibility="Collapsed"
                            Margin="8,0,0,0" Padding="6,3" Click="OnFindError"/>
                    <TextBlock x:Name="PatternStatus" TextWrapping="Wrap" Foreground="#A8B7CB"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Pattern status"/>
                </DockPanel>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Load sample…" Padding="8,4" Click="OnLoadSample"/>
                    <TextBlock Text="Sample text" Style="{StaticResource SectionTitle}"/>
                </DockPanel>
                <TextBlock x:Name="SampleHint" Grid.Row="1" Text="{Binding SampleHint}" Foreground="#A8B7CB"
                           Margin="0,3,0,5" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <TextBox x:Name="SampleInput" Grid.Row="2" Text="{Binding Sample, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Sample text"/>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="PreviousMatch" Content="‹" Padding="9,3" Margin="4,0"
                                AutomationProperties.Name="Previous match" Click="OnPreviousMatch"/>
                        <Button x:Name="NextMatch" Content="›" Padding="9,3"
                                AutomationProperties.Name="Next match" Click="OnNextMatch"/>
                    </StackPanel>
                    <TextBlock x:Name="ResultSummary" Style="{StaticResource SectionTitle}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
                <Border Grid.Row="1" Background="#101620" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="HighlightedSample" Padding="8" TextWrapping="Wrap"
                                   FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Highlighted sample"/>
                    </ScrollViewer>
                </Border>
                <TextBox x:Name="MatchDetails" Grid.Row="2" Margin="0,6,0,0" MaxHeight="72" IsReadOnly="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected match and captured groups"/>
            </Grid>
        </Grid>
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6">
            <ScrollViewer x:Name="SyntaxScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="12"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, ElementName=SyntaxScroll}" Value="Visible">
                                    <Setter Property="Margin" Value="12,12,28,12"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Syntax" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="Click a fragment to insert it." Foreground="#A8B7CB" Margin="0,4,0,8"/>
                    <TextBlock Text="Characters" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Button Style="{StaticResource Snippet}" Content=".   Any character except newline" Tag="." ToolTip="c.t matches cat and cut"/>
                    <Button Style="{StaticResource Snippet}" Content="\d   Digit" Tag="\d" ToolTip="\d+ matches 123"/>
                    <Button Style="{StaticResource Snippet}" Content="\s   Whitespace" Tag="\s" ToolTip="a\sb matches a space or tab between a and b"/>
                    <Button Style="{StaticResource Snippet}" Content="[a-z]   Character range" Tag="[a-z]" ToolTip="[a-z]+ matches a sequence of letters in the range a–z"/>
                    <TextBlock Text="Repetition" FontWeight="SemiBold" Margin="0,6,0,4"/>
                    <Button Style="{StaticResource Snippet}" Content="+   One or more" Tag="+" ToolTip="a+ matches a and aaa"/>
                    <Button Style="{StaticResource Snippet}" Content="?   Optional" Tag="?" ToolTip="colou?r matches color and colour"/>
                    <Button Style="{StaticResource Snippet}" Content="{}{2,4}   Two to four" Tag="{}{2,4}" ToolTip="\d{2,4} matches two to four consecutive digits"/>
                    <TextBlock Text="Positions and groups" FontWeight="SemiBold" Margin="0,6,0,4"/>
                    <Button Style="{StaticResource Snippet}" Content="^   Start of line" Tag="^" ToolTip="^Error matches Error at the beginning of a line"/>
                    <Button Style="{StaticResource Snippet}" Content="$   End of line" Tag="$" ToolTip="\.pdf$ matches .pdf at the end of a file name"/>
                    <Button Style="{StaticResource Snippet}" Content="\b   Word boundary" Tag="\b" ToolTip="\bcat\b matches cat as a whole word"/>
                    <Button Style="{StaticResource Snippet}" Content="(?&lt;name&gt;…)   Named group" Tag="(?&lt;name&gt;)" ToolTip="(?&lt;year&gt;\d{4}) captures four digits under year"/>
                    <TextBlock Text="Examples" FontWeight="SemiBold" Margin="0,10,0,4"/>
                    <ComboBox x:Name="Examples" AutomationProperties.Name="Regex examples" SelectionChanged="OnExampleChanged"/>
                    <Expander Header="Escape literal text" Margin="0,12,0,0">
                        <StackPanel Margin="0,6,0,0">
                            <TextBox x:Name="LiteralInput" AutomationProperties.Name="Literal text to escape"/>
                            <Button Content="Insert escaped text" Click="OnInsertLiteral" Margin="0,6,0,0" Padding="7,5"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="ApplyButton" Content="Use pattern" IsEnabled="False" Click="OnApply"/>
        </StackPanel>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XtraSearch</AssemblyName>
    <RootNamespace>XtraSearch</RootNamespace>
    <UseSharedCompilation>false</UseSharedCompilation>
    <CscToolPath>$(MSBuildToolsPath)/Roslyn/bincore</CscToolPath>
    <CscToolExe>csc.exe</CscToolExe>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="build-tools/**/*.cs" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
  </ItemGroup>
  <UsingTask TaskName="Microsoft.CodeAnalysis.BuildTasks.Csc" AssemblyFile="$(MSBuildProjectDirectory)/build-tools/XtraSearch.Compiler.dll" Override="true" />
</Project>
